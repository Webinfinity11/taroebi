# Database. Local dev: leave as file:.pglite (embedded Postgres, no account needed).
# Production: Neon URLs (pooled for the app, unpooled for drizzle-kit).
DATABASE_URL=file:.pglite
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
# Session signing secret — any long random string (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Vercel Blob token for product image uploads
BLOB_READ_WRITE_TOKEN=
# Public site URL (used for metadata / sitemap)
SITE_URL=http://localhost:3000
